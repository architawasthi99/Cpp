#include<iostream>
#include<list>
using namespace std;
class Node{
    public:
        int data;
        Node* next;
    Node(int val){
        data=val;
        next=NULL;
    }    
};
//connection
class List{
    Node* head;
    Node* tail;
    public:
        List(){
            head=tail=NULL;
        }
     //case 1 empty linkedlist
    void push_front(int val){
        Node* newNode=new Node(val);
        if(head==NULL){
            head=tail=newNode;
            return;
        }
        else{
            newNode->next=head;
            head=newNode;
        }
    }
    void push_back(int val){
        Node* newNode=new Node(val);
        if(head==NULL){
            head=tail=NULL;
            return;
        }
        else{
            tail->next=newNode;
            tail=newNode;
        }
    }
    void printll(){
        Node* temp=head;
        while(temp!=NULL){
            cout<<temp->data<<" ";
            temp=temp->next;
        }
        cout<<endl;
    }
};
int main(){
    List ll;
    ll.push_front(1);
    ll.push_front(2);
    ll.push_front(3);
    ll.push_front(4);
    
    ll.push_back(10);
    ll.printll();
}
